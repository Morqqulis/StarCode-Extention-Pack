{
	"name": "starcode",
	"publisher": "dmitriy-iskenderov",
	"displayName": "StarCode",
	"description": "StarCode Extension Pack - Essential extensions, settings, snippets and fonts for VS Code, Cursor and Windsurf",
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Extension Packs"
	],
	"keywords": [
		"extension pack",
		"prettier",
		"eslint",
		"snippets",
		"fonts"
	],
	"icon": "public/logo.jpg",
	"repository": {
		"type": "git",
		"url": "https://github.com/dmitriy-iskenderov/StarCode-Extention-Pack.git"
	},
	"extensionPack": [
		"esbenp.prettier-vscode",
		"dbaeumer.vscode-eslint",
		"ritwickdey.LiveServer",
		"diz.ecsstractor-port",
		"bradgashler.htmltagwrap",
		"fractalbrew.backticks",
		"PKief.material-icon-theme",
		"lior-chamla.google-fonts",
		"christian-kohler.path-intellisense"
	],
	"extensionRecommendations": [
		"bradlc.vscode-tailwindcss",
		"heybourn.headwind",
		"yoavbls.pretty-ts-errors",
		"kohlbachjan.the-best-theme",
		"github.copilot",
		"codestackr.codestackr-theme",
		"piyushsarkar.sort-css-properties",
		"mikestead.dotenv"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"configurationDefaults": {
			"editor.formatOnSave": true,
			"editor.formatOnPaste": true,
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.fontFamily": "JetBrains Mono, monospace",
			"editor.tabSize": 3,
			"editor.detectIndentation": false,
			"editor.autoIndent": "full",
			"editor.wordWrap": "bounded",
			"editor.wordWrapColumn": 120,
			"editor.fontWeight": "500",
			"editor.tabCompletion": "on",
			"editor.smoothScrolling": true,
			"editor.cursorBlinking": "smooth",
			"editor.cursorStyle": "line-thin",
			"editor.linkedEditing": true,
			"editor.scrollbar.horizontal": "hidden",
			"editor.scrollbar.vertical": "hidden",
			"editor.cursorSmoothCaretAnimation": "on",
			"workbench.list.smoothScrolling": true,
			"editor.mouseWheelZoom": true,
			"prettier.htmlWhitespaceSensitivity": "strict",
			"prettier.ignorePath": ".prettierignore",
			"editor.codeActionsOnSave": {
				"source.fixAll": "explicit",
				"source.organizeImports": "explicit",
				"source.fixAll.eslint": "explicit"
			},
			"explorer.confirmDragAndDrop": false,
			"explorer.confirmDelete": false,
			"security.workspace.trust.untrustedFiles": "open",
			"html.hover.documentation": false,
			"html.hover.references": false,
			"htmltagwrap.tag": "span",
			"html.format.wrapAttributes": "aligned-multiple",
			"css.lint.emptyRules": "ignore",
			"scss.lint.emptyRules": "ignore",
			"css.lint.unknownAtRules": "ignore",
			"scss.lint.unknownAtRules": "ignore",
			"emmet.useInlineCompletions": true,
			"emmet.preferences": {
				"output.reverseAttributes": true,
				"output.inlineBreak": 1
			},
			"prettier.tabWidth": 3,
			"prettier.printWidth": 120,
			"prettier.singleQuote": true,
			"prettier.trailingComma": "all",
			"prettier.arrowParens": "avoid",
			"prettier.bracketSpacing": true,
			"prettier.useTabs": true,
			"prettier.semi": false,
			"eslint.enable": true,
			"eslint.format.enable": true,
			"eslint.run": "onSave",
			"eslint.validate": [
				"javascript",
				"javascriptreact",
				"typescript",
				"typescriptreact",
				"html",
				"css",
				"scss"
			],
			"terminal.integrated.defaultProfile.windows": "Git Bash",
			"liveServer.settings.donotShowInfoMsg": true
		},
		"keybindings": [
			{
				"key": "f3",
				"command": "editor.action.formatDocument",
				"when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly"
			}
		],
		"snippets": [
			{
				"language": "html",
				"path": "./snippets/global.code-snippets"
			},
			{
				"language": "javascript",
				"path": "./snippets/global.code-snippets"
			},
			{
				"language": "typescript",
				"path": "./snippets/global.code-snippets"
			},
			{
				"language": "css",
				"path": "./snippets/global.code-snippets"
			},
			{
				"language": "scss",
				"path": "./snippets/global.code-snippets"
			}
		],
		"commands": [
			{
				"command": "starcode.installFonts",
				"title": "Install JetBrains Mono Fonts"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"build": "node scripts/build.js",
		"create-vsix": "npm run compile && npx @vscode/vsce package"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/vscode": "^1.90.0",
		"typescript": "^5.6.0",
		"@vscode/vsce": "^3.7.1"
	}
}
