{
	"name": "starcode",
	"publisher": "dmitriy-iskenderov",
	"displayName": "StarCode",
	"description": "StarCode Extension Pack - Essential extensions, settings, snippets and fonts for VS Code, Cursor and Windsurf",
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": [
		"Extension Packs"
	],
	"keywords": [
		"extension pack",
		"prettier",
		"eslint",
		"snippets",
		"fonts"
	],
	"icon": "public/logo.jpg",
	"repository": {
		"type": "git",
		"url": "https://github.com/dmitriy-iskenderov/StarCode-Extention-Pack.git"
	},
	"extensionPack": [
		"esbenp.prettier-vscode",
		"dbaeumer.vscode-eslint",
		"ritwickdey.LiveServer",
		"diz.ecsstractor-port",
		"bradgashler.htmltagwrap",
		"fractalbrew.backticks",
		"PKief.material-icon-theme",
		"lior-chamla.google-fonts",
		"christian-kohler.path-intellisense"
	],
	"extensionRecommendations": [
		"bradlc.vscode-tailwindcss",
		"heybourn.headwind",
		"yoavbls.pretty-ts-errors",
		"kohlbachjan.the-best-theme",
		"github.copilot",
		"codestackr.codestackr-theme",
		"piyushsarkar.sort-css-properties",
		"mikestead.dotenv"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": {
			"title": "StarCode",
			"properties": {
				"editor.formatOnSave": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: editor.formatOnSave"
				},
				"editor.formatOnPaste": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: editor.formatOnPaste"
				},
				"editor.defaultFormatter": {
					"type": "string",
					"default": "esbenp.prettier-vscode",
					"description": "StarCode setting: editor.defaultFormatter"
				},
				"editor.fontFamily": {
					"type": "string",
					"default": "JetBrains Mono, monospace",
					"description": "StarCode setting: editor.fontFamily"
				},
				"editor.tabSize": {
					"type": "number",
					"default": 3,
					"description": "StarCode setting: editor.tabSize"
				},
				"editor.detectIndentation": {
					"type": "boolean",
					"default": false,
					"description": "StarCode setting: editor.detectIndentation"
				},
				"editor.autoIndent": {
					"type": "string",
					"default": "full",
					"description": "StarCode setting: editor.autoIndent"
				},
				"editor.wordWrap": {
					"type": "string",
					"default": "bounded",
					"description": "StarCode setting: editor.wordWrap"
				},
				"editor.wordWrapColumn": {
					"type": "number",
					"default": 120,
					"description": "StarCode setting: editor.wordWrapColumn"
				},
				"editor.fontWeight": {
					"type": "string",
					"default": "500",
					"description": "StarCode setting: editor.fontWeight"
				},
				"editor.tabCompletion": {
					"type": "string",
					"default": "on",
					"description": "StarCode setting: editor.tabCompletion"
				},
				"editor.smoothScrolling": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: editor.smoothScrolling"
				},
				"editor.cursorBlinking": {
					"type": "string",
					"default": "smooth",
					"description": "StarCode setting: editor.cursorBlinking"
				},
				"editor.cursorStyle": {
					"type": "string",
					"default": "line-thin",
					"description": "StarCode setting: editor.cursorStyle"
				},
				"editor.linkedEditing": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: editor.linkedEditing"
				},
				"editor.scrollbar.horizontal": {
					"type": "string",
					"default": "hidden",
					"description": "StarCode setting: editor.scrollbar.horizontal"
				},
				"editor.scrollbar.vertical": {
					"type": "string",
					"default": "hidden",
					"description": "StarCode setting: editor.scrollbar.vertical"
				},
				"editor.cursorSmoothCaretAnimation": {
					"type": "string",
					"default": "on",
					"description": "StarCode setting: editor.cursorSmoothCaretAnimation"
				},
				"workbench.list.smoothScrolling": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: workbench.list.smoothScrolling"
				},
				"editor.mouseWheelZoom": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: editor.mouseWheelZoom"
				},
				"prettier.htmlWhitespaceSensitivity": {
					"type": "string",
					"default": "strict",
					"description": "StarCode setting: prettier.htmlWhitespaceSensitivity"
				},
				"prettier.ignorePath": {
					"type": "string",
					"default": ".prettierignore",
					"description": "StarCode setting: prettier.ignorePath"
				},
				"editor.codeActionsOnSave": {
					"type": "object",
					"default": {
						"source.fixAll": "explicit",
						"source.organizeImports": "explicit",
						"source.fixAll.eslint": "explicit"
					},
					"description": "StarCode setting: editor.codeActionsOnSave"
				},
				"explorer.confirmDragAndDrop": {
					"type": "boolean",
					"default": false,
					"description": "StarCode setting: explorer.confirmDragAndDrop"
				},
				"explorer.confirmDelete": {
					"type": "boolean",
					"default": false,
					"description": "StarCode setting: explorer.confirmDelete"
				},
				"security.workspace.trust.untrustedFiles": {
					"type": "string",
					"default": "open",
					"description": "StarCode setting: security.workspace.trust.untrustedFiles"
				},
				"html.hover.documentation": {
					"type": "boolean",
					"default": false,
					"description": "StarCode setting: html.hover.documentation"
				},
				"html.hover.references": {
					"type": "boolean",
					"default": false,
					"description": "StarCode setting: html.hover.references"
				},
				"htmltagwrap.tag": {
					"type": "string",
					"default": "span",
					"description": "StarCode setting: htmltagwrap.tag"
				},
				"html.format.wrapAttributes": {
					"type": "string",
					"default": "aligned-multiple",
					"description": "StarCode setting: html.format.wrapAttributes"
				},
				"css.lint.emptyRules": {
					"type": "string",
					"default": "ignore",
					"description": "StarCode setting: css.lint.emptyRules"
				},
				"scss.lint.emptyRules": {
					"type": "string",
					"default": "ignore",
					"description": "StarCode setting: scss.lint.emptyRules"
				},
				"css.lint.unknownAtRules": {
					"type": "string",
					"default": "ignore",
					"description": "StarCode setting: css.lint.unknownAtRules"
				},
				"scss.lint.unknownAtRules": {
					"type": "string",
					"default": "ignore",
					"description": "StarCode setting: scss.lint.unknownAtRules"
				},
				"emmet.useInlineCompletions": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: emmet.useInlineCompletions"
				},
				"emmet.preferences": {
					"type": "object",
					"default": {
						"output.reverseAttributes": true,
						"output.inlineBreak": 1
					},
					"description": "StarCode setting: emmet.preferences"
				},
				"prettier.tabWidth": {
					"type": "number",
					"default": 3,
					"description": "StarCode setting: prettier.tabWidth"
				},
				"prettier.printWidth": {
					"type": "number",
					"default": 120,
					"description": "StarCode setting: prettier.printWidth"
				},
				"prettier.singleQuote": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: prettier.singleQuote"
				},
				"prettier.trailingComma": {
					"type": "string",
					"default": "all",
					"description": "StarCode setting: prettier.trailingComma"
				},
				"prettier.arrowParens": {
					"type": "string",
					"default": "avoid",
					"description": "StarCode setting: prettier.arrowParens"
				},
				"prettier.bracketSpacing": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: prettier.bracketSpacing"
				},
				"prettier.useTabs": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: prettier.useTabs"
				},
				"prettier.semi": {
					"type": "boolean",
					"default": false,
					"description": "StarCode setting: prettier.semi"
				},
				"eslint.enable": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: eslint.enable"
				},
				"eslint.format.enable": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: eslint.format.enable"
				},
				"eslint.run": {
					"type": "string",
					"default": "onSave",
					"description": "StarCode setting: eslint.run"
				},
				"eslint.validate": {
					"type": "array",
					"default": [
						"javascript",
						"javascriptreact",
						"typescript",
						"typescriptreact",
						"html",
						"css",
						"scss"
					],
					"description": "StarCode setting: eslint.validate"
				},
				"terminal.integrated.defaultProfile.windows": {
					"type": "string",
					"default": "Git Bash",
					"description": "StarCode setting: terminal.integrated.defaultProfile.windows"
				},
				"liveServer.settings.donotShowInfoMsg": {
					"type": "boolean",
					"default": true,
					"description": "StarCode setting: liveServer.settings.donotShowInfoMsg"
				}
			}
		},
		"keybindings": [
			{
				"key": "f3",
				"command": "editor.action.formatDocument",
				"when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly"
			}
		],
		"snippets": [
			{
				"language": "*",
				"path": "./snippets/global.code-snippets"
			}
		],
		"commands": [
			{
				"command": "starcode.installFonts",
				"title": "Install JetBrains Mono Fonts"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"build": "node scripts/build.js",
		"create-vsix": "npm run compile && npx @vscode/vsce package"
	},
	"devDependencies": {
		"@types/node": "^20.14.0",
		"@types/vscode": "^1.60.0",
		"typescript": "^5.5.0",
		"@vscode/vsce": "^2.24.0"
	}
}
